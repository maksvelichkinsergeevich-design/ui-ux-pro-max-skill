# --- Обязательно ---
# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AA...

# --- Для умных сводок по новостям (рекомендуется) ---
# Ключ Anthropic API: https://console.anthropic.com/
# Если не задан, бот всё равно работает, но выдаёт новости списком без ИИ-резюме.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Необязательно ---
# Через запятую: Telegram user_id, которым разрешён доступ. Пусто = доступ всем.
ALLOWED_USER_IDS=

# Путь к файлу базы данных SQLite
DATABASE_PATH=investment_bot.db

# Часовой пояс для ежедневной сводки (по умолчанию Europe/Moscow)
TIMEZONE=Europe/Moscow

# Время ежедневной автосводки в формате HH:MM (пусто = не отправлять)
DAILY_DIGEST_TIME=09:30
